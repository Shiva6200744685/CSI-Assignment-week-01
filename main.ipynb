   "source": [
    "# Identify the target column and ID column\n",
    "target_col = [col for col in ['price', 'SalePrice'] if col in train.columns][0]\n",
    "id_col = [col for col in ['id', 'Id'] if col in test.columns][0]  # From test, not train\n",
    "\n",
    "# One-hot encode both datasets\n",
    "train_encoded = pd.get_dummies(train)\n",
    "test_encoded = pd.get_dummies(test)\n",
    "\n",
    "# Align columns in train and test (required for ML model input)\n",
    "train_encoded, test_encoded = train_encoded.align(test_encoded, join='left', axis=1, fill_value=0)\n",
    "\n",
    "# Split train into X (features) and y (target)\n",
    "X = train_encoded.drop(target_col, axis=1)\n",
    "y = train_encoded[target_col]\n",
    "\n",
    "# Define X_test (final test input) by dropping ID if present\n",
    "X_test = test_encoded.drop(id_col, axis=1)\n"
   ]
