   "source": [
    "# Step 1: Identify numeric columns from train, excluding 'price'\n",
    "numeric_cols = train.select_dtypes(include=['number']).columns.drop('price', errors='ignore')\n",
    "\n",
    "# Step 2: Fill train numeric columns with their own median\n",
    "train[numeric_cols] = train[numeric_cols].fillna(train[numeric_cols].median())\n",
    "\n",
    "# Step 3: Filter numeric columns that are also in test\n",
    "common_numeric_cols = numeric_cols.intersection(test.columns)\n",
    "\n",
    "# Step 4: Fill test numeric columns\n",
    "test[common_numeric_cols] = test[common_numeric_cols].fillna(test[common_numeric_cols].median())\n",
    "\n",
    "# Step 5: Handle categorical columns\n",
    "categorical_cols = train.select_dtypes(include=['object']).columns\n",
    "\n",
    "# Fill train categorical columns with mode\n",
    "train[categorical_cols] = train[categorical_cols].fillna(train[categorical_cols].mode().iloc[0])\n",
    "\n",
    "# Filter common categorical columns for test\n",
    "common_cat_cols = categorical_cols.intersection(test.columns)\n",
    "\n",
    "# Fill test categorical columns with mode from train\n",
    "test[common_cat_cols] = test[common_cat_cols].fillna(train[common_cat_cols].mode().iloc[0])\n"
   ]
  },
